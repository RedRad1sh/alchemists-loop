; Copy to export_presets.cfg after installing Android export templates and plugins.
; Keep the real keystore paths/passwords out of Git.
;
; Two builds use the same package id and versionCode sequence. The store is
; selected by custom_features: google_play or rustore.

[preset.0]
name="Google Play"
platform="Android"
runnable=true
advanced_options=true
custom_features="google_play"
export_filter="all_resources"
include_filter=""
exclude_filter=""
export_path="build/alchemists-loop-gp.aab"
patches=PackedStringArray()

[preset.0.options]
custom_template/debug=""
custom_template/release=""
gradle_build/use_gradle_build=true
architectures/armeabi-v7a=false
architectures/arm64-v8a=true
architectures/x86=false
architectures/x86_64=false
version/code=20000
version/name="0.2.0"
package/unique_name="com.example.alchemistsloop"
package/name="Alchemist's Loop"
package/signed=true
target_sdk=36
permissions/internet=true
permissions/vibrate=true

[preset.1]
name="RuStore"
platform="Android"
runnable=true
advanced_options=true
custom_features="rustore"
export_filter="all_resources"
include_filter=""
exclude_filter=""
export_path="build/alchemists-loop-rustore.aab"
patches=PackedStringArray()

[preset.1.options]
custom_template/debug=""
custom_template/release=""
gradle_build/use_gradle_build=true
architectures/armeabi-v7a=false
architectures/arm64-v8a=true
architectures/x86=false
architectures/x86_64=false
version/code=20000
version/name="0.2.0"
package/unique_name="com.example.alchemistsloop"
package/name="Alchemist's Loop"
package/signed=true
target_sdk=36
permissions/internet=true
permissions/vibrate=true
